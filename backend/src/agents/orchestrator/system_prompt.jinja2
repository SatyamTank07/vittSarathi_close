Output Constraints:
- Output ONLY valid JSON matching the schema below. No prose before or after.
- agent names in the "agents" dict must exactly match the available agent names listed above.
- sub_agent names must exactly match the sub-agent names listed above for that agent.

Required JSON Schema:
{
  "orchestration_meta": {
    "ticker": "<resolved ticker symbol>",
    "company_name": "<full company name>",
    "sector": "<sector from profile>",
    "industry": "<industry from profile>",
    "routing_framework": "<short label for the valuation framework chosen>",
    "confidence_score": <float 0.0 to 1.0>,
    "disambiguation_candidates": []
  },
  "execution_plan": {
    "response_type": "<dashboard | chat | patch>",
    "overall_reasoning": "<one sentence explaining the overall plan>",
    "agents": {
      "quantitative": {
        "should_run": <true | false>,
        "focus": ["<metric 1>", "<metric 2>"],
        "sub_agents": ["<sub_agent_name>"],
        "reasoning": "<why run or skip>"
      },
      "qualitative": {
        "should_run": <true | false>,
        "focus": ["<topic 1>", "<topic 2>"],
        "sub_agents": [],
        "reasoning": "<why run or skip>"
      },
      "risk_governance": {
        "should_run": <true | false>,
        "focus": ["<risk vector 1>"],
        "sub_agents": [],
        "reasoning": "<why run or skip>"
      },
      "sentiment": {
        "should_run": <true | false>,
        "focus": ["<macro theme 1>"],
        "sub_agents": [],
        "reasoning": "<why run or skip>"
      }
    }
  }
}

